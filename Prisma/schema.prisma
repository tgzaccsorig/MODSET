generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  username  String?  @unique
  createdAt DateTime @default(now())
  packs     Pack[]
}

model MinecraftVersion {
  id          String    @id @default(cuid())
  version     String    @unique
  type        String    // release | snapshot | old_beta | old_alpha
  releaseDate DateTime
  isMajor     Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([type])
  @@index([isMajor])
}

model Loader {
  id   String @id @default(cuid())
  slug String @unique
  name String
  icon String?
}

model Category {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String?
  icon        String?
  modLinks    ModCategory[]
}

model Mod {
  id          String   @id @default(cuid())
  modrinthId  String   @unique
  slug        String   @unique
  name        String
  description String
  iconUrl     String?
  projectUrl  String?
  license     String?
  environment String?  // client | server | both
  downloads   BigInt   @default(0)
  follows     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions     ModVersion[]
  categories   ModCategory[]
  rules        RecommendationRule[]
  packMods     PackMod[]
  dependenciesAsMod   ModDependency[]  @relation("dep_mod")

  @@index([slug])
  @@index([downloads])
}

model ModVersion {
  id                 String   @id @default(cuid())
  modId              String
  modrinthVersionId  String   @unique
  minecraftVersion   String
  loader             String
  versionNumber      String
  versionType        String   // release | beta | alpha
  fileUrl            String
  fileName           String
  fileSize           BigInt
  sha1               String?
  sha512             String?
  environment        String?
  publishedAt        DateTime

  mod          Mod              @relation(fields: [modId], references: [id], onDelete: Cascade)
  depsFrom     ModDependency[]  @relation("dep_from")
  depsTo       ModDependency[]  @relation("dep_to")
  packMods     PackMod[]

  @@index([modId, minecraftVersion, loader])
  @@index([modrinthVersionId])
}

model ModDependency {
  id                  String @id @default(cuid())
  modVersionId        String
  dependencyModId     String?
  dependencyVersionId String?
  type                String // required | optional | incompatible | embedded

  modVersion        ModVersion  @relation("dep_from", fields: [modVersionId], references: [id], onDelete: Cascade)
  dependencyMod     Mod?        @relation("dep_mod", fields: [dependencyModId], references: [id])
  dependencyVersion ModVersion? @relation("dep_to", fields: [dependencyVersionId], references: [id])

  @@index([modVersionId])
  @@index([dependencyModId])
}

model ModCategory {
  modId      String
  categoryId String
  score      Float  @default(0)

  mod      Mod      @relation(fields: [modId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([modId, categoryId])
  @@index([categoryId, score])
}

model Pack {
  id               String   @id @default(cuid())
  userId           String?
  name             String
  description      String?
  minecraftVersion String
  loader           String
  isPublic         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user        User?             @relation(fields: [userId], references: [id])
  mods        PackMod[]
  generations PackGeneration[]

  @@index([minecraftVersion, loader])
  @@index([createdAt])
}

model PackMod {
  packId        String
  modId         String
  modVersionId  String
  source        String  // recommended | manual | dependency
  required      Boolean @default(false)

  pack       Pack       @relation(fields: [packId], references: [id], onDelete: Cascade)
  mod        Mod        @relation(fields: [modId], references: [id])
  modVersion ModVersion @relation(fields: [modVersionId], references: [id])

  @@id([packId, modId])
  @@index([packId])
}

model PackGeneration {
  id        String   @id @default(cuid())
  packId    String
  status    String   // queued | processing | ready | failed | expired
  progress  Int      @default(0)
  stage     String?
  fileUrl   String?
  fileSize  BigInt?
  error     String?
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pack Pack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@index([packId])
  @@index([status])
}

model RecommendationRule {
  id               String  @id @default(cuid())
  modId            String
  categoryId       String?
  loader           String?
  minecraftMin     String?
  minecraftMax     String?
  priority         Int     @default(0)
  recommended      Boolean @default(false)
  enabled          Boolean @default(true)
  enabledByDefault Boolean @default(false)

  mod Mod @relation(fields: [modId], references: [id], onDelete: Cascade)

  @@index([modId])
  @@index([categoryId])
}
